# --- Rust / cargo ---
target/
**/*.rs.bk

# --- spike runtime data (latency-matrix datasets etc.) ---
spike-data/

# --- logs & env ---
*.log
.env

# --- Python (boto3 conformance client) ---
__pycache__/
.venv/
*.pyc

# --- Go (aws-sdk-go-v2 conformance client): build outputs only ---
# (module dir spike/conformance/go/ and the scripts in spike/conformance/ stay
# tracked; bare "conformance" patterns would ignore the whole directory — fixed
# by anchoring to the module dir where `go build` emits binaries)
spike/conformance/go/conformance
spike/conformance/go/vf-conformance
spike/conformance/go/conformance-*
spike/conformance/go/vf-conformance-*
spike/conformance/go/*.test
spike/conformance/go/*.out

# --- editor / OS noise ---
.DS_Store
*.swp
