# --- Rust / cargo ---
target/
**/*.rs.bk

# --- spike runtime data (latency-matrix datasets etc.) ---
spike-data/

# --- logs & env ---
*.log
.env

# --- Python (boto3 conformance client) ---
__pycache__/
.venv/
*.pyc

# --- Go (aws-sdk-go-v2 conformance client): build outputs only ---
# (module dir conformance/go/ and the scripts in conformance/ stay tracked;
# bare "conformance" patterns would ignore the whole directory — fixed by
# anchoring to the module dir where `go build` emits binaries)
conformance/go/conformance
conformance/go/vf-conformance
conformance/go/conformance-*
conformance/go/vf-conformance-*
conformance/go/*.test
conformance/go/*.out

# --- editor / OS noise ---
.DS_Store
*.swp

# --- IDE ---
.idea/

# --- dynamic-load runtime libraries (scripts/fetch_runtime_libs.sh, §5.10.7) ---
# pinned .so/.dylib downloads (pdfium now, onnxruntime in T5) never enter the
# tree; the fetch script + CI cache restore them deterministically.
runtime-libs/
target-docker/
target-bullseye/
